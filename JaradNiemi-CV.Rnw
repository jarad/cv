<<mentoring, dependson="service", results='asis', cache.extra = tools::md5sum("data/mentoring.csv"), message=FALSE>>=
# mentoring sits with the advisees rather than under service: it is work with
# individual students, not committee work
m = readr::read_csv("data/mentoring.csv") %>%
  arrange(desc(start_date)) %>%
  transmute(Student = student, Program = programme,
            Institution = institution, Years = span(start_date, end_date))

print(xtable(m,
             caption = "Students mentored",
             label   = "tab:mentoring"),
      include.rownames  = FALSE,
      table.placement   = "h",
      caption.placement = "top")
@




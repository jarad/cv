\section{\bf Talks}

<<read_presentations, dependson="read_pubs", cache=TRUE, cache.extra = tools::md5sum("data/presentations.csv"), message=FALSE>>=
pres = readr::read_csv("data/presentations.csv")

# ISO 8601 at whatever precision was recorded -> the CV's display form
fmt_date = function(d) {
  if (is.na(d)) return("")
  if (nchar(d) == 4) return(d)
  if (nchar(d) == 7) return(format(as.Date(paste0(d, "-01")), "%B %Y"))
  sub("^0", "", format(as.Date(d), "%d %b %Y"))
}

# a trailing parenthetical: whether it was invited, plus any note
annotate = function(d, show_solicitation = TRUE) {
  bits = c(if (show_solicitation && !is.na(d$solicitation)) d$solicitation,
           if (!is.na(d$notes)) d$notes)
  if (!length(bits)) "" else paste0(" (", paste(bits, collapse="; "), ")")
}

# "A", "A and B", "A, B, and C"
name_list = function(v) {
  v = v[!is.na(v) & v != ""]
  if (length(v) <= 1) return(paste(v, collapse=""))
  if (length(v) == 2) return(paste(v, collapse=" and "))
  paste0(paste(v[-length(v)], collapse=", "), ", and ", v[length(v)])
}
@

<<talks, dependson="read_presentations", results='asis'>>=
talks = pres %>%
  filter(kind == "talk") %>%
  arrange(desc(coalesce(date, "0000")))

# one promotion marker, placed where the list crosses the cutoff, rather than
# eight markers positioned by hand
was_since = TRUE
for (i in seq_len(nrow(talks))) {
  d = talks[i,]
  since = !is.na(d$date) && iso_floor(d$date) >= PROMOTION_DATE
  if (was_since && !since) cat("\n\\sinceappt\n\n")
  was_since = since
  cat("``", tex_text(d$title), ",'' ", tex_text(d$venue),
      if (!is.na(d$date)) paste0(", ", fmt_date(d$date)) else "",
      annotate(d), "\n\n", sep="")
}
@

\filbreak
\section{\bf Posters}

<<posters, dependson="read_presentations", results='asis'>>=
posters = pres %>%
  filter(kind == "poster") %>%
  arrange(desc(coalesce(date, "0000")))

cat("{\\small\n")
was_since = TRUE
for (i in seq_len(nrow(posters))) {
  d = posters[i,]
  since = !is.na(d$date) && iso_floor(d$date) >= PROMOTION_DATE
  if (was_since && !since) cat("\n\\sinceappt\n\n")
  was_since = since
  # posters are always contributed, so printing it on every row is noise
  who = name_list(c(d$presenting_author,
                    if (!is.na(d$work_authors)) trimws(strsplit(d$work_authors, ",")[[1]])))
  cat(decorate_authors(who), ". ", tex_text(d$title), ".",
      if (!is.na(d$venue)) paste0(" ", tex_text(d$venue)) else "",
      if (!is.na(d$date)) paste0(", ", fmt_date(d$date)) else "",
      annotate(d, show_solicitation = FALSE), "\n\n", sep="")
}
cat("}\n")
@

\section{\bf News interviews (hyperlinked)}

<<news, dependson="helpers", cache=TRUE, cache.extra = tools::md5sum("data/news.csv"), results='asis', message=FALSE>>=
nw = readr::read_csv("data/news.csv")

# one outlet interviewed me several times, so its years are listed after it
items = character(0)
for (o in unique(nw$outlet)) {
  d = nw[nw$outlet == o,]
  if (nrow(d) == 1 && is.na(d$year[1])) {
    items = c(items, if (is.na(d$url[1])) tex_text(o)
                     else paste0("\\href{", d$url[1], "}{", tex_text(o), "}"))
  } else if (nrow(d) == 1) {
    lbl = if (is.na(d$url[1])) tex_text(o) else paste0("\\href{", d$url[1], "}{", tex_text(o), "}")
    items = c(items, lbl)
  } else {
    d = d[order(d$year),]
    yrs = mapply(function(y, u) if (is.na(u)) y else paste0("\\href{", u, "}{", y, "}"),
                 d$year, d$url)
    items = c(items, paste0(tex_text(o), " (", paste(yrs, collapse = ", "), ")"))
  }
}
cat(paste(items, collapse = ",\n"), "\n", sep="")
@


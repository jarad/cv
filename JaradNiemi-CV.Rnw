\section{\bf Service}

<<service, dependson="read_presentations", cache=TRUE, cache.extra = tools::md5sum("data/service.csv"), results='asis', message=FALSE>>=
service = readr::read_csv("data/service.csv")


render_item = function(d) {
  d = d[order(-as.integer(substr(d$start_date, 1, 4))),]
  org = d$organization[1]; act = d$activity[1]
  label = if (is.na(act)) org
          else if (is.na(org) || identical(org, d$group[1])) act
          else paste0(act, ", ", org)
  label = tex_text(label)
  if (!is.na(d$url[1])) label = paste0("\\href{", d$url[1], "}{", label, "}")

  parts = character(0)
  roles = c(if (any(is.na(d$role))) NA_character_, unique(d$role[!is.na(d$role)]))
  for (r in roles) {
    k = if (is.na(r)) is.na(d$role) else (!is.na(d$role) & d$role == r)
    k = k & !is.na(d$start_date)
    if (!any(k)) next
    yrs = paste(span(d$start_date[k], d$end_date[k]), collapse = ", ")
    parts = c(parts, if (is.na(r)) paste0("(", yrs, ")")
                     else paste0(tex_text(r), " (", yrs, ")"))
  }
  sep = if (!length(parts)) "" else if (startsWith(parts[1], "(")) " " else ", "
  cat("\\item ", label, sep, paste(parts, collapse = ", "), "\n", sep="")
}

render_group = function(d) {
  d = d[order(-as.integer(substr(d$start_date, 1, 4))),]
  key = paste(coalesce(d$organization, ""), coalesce(d$activity, ""), sep = "\r")
  for (k in unique(key)) render_item(d[key == k,])
}

cat("\\begin{itemize}\n")
for (cat_name in c("Profession", "University service", "Departmental/Program service")) {
  dd = service[service$category == cat_name,]
  if (!nrow(dd)) next
  cat("\\item {\\bf ", cat_name, "}\n\\begin{itemize}\n", sep="")
  render_group(dd[is.na(dd$group),])
  for (g in unique(dd$group[!is.na(dd$group)])) {
    cat("\\item ", tex_text(g), "\n\\begin{itemize}\n", sep="")
    render_group(dd[!is.na(dd$group) & dd$group == g,])
    cat("\\end{itemize}\n")
  }
  cat("\\end{itemize}\n")
}
cat("\\end{itemize}\n")
@

\newpage
\section{\bf Student Committees and Advisees}

\vspace{0.1in}

<<read_studentcommittees, cache.extra = c(tools::md5sum("data/studentcommittees.csv"), tools::md5sum("data/people.csv"))>>=
# library(plyr)
library(dplyr)
library(xtable)

people = readr::read_csv("data/people.csv")

d = readr::read_csv("data/studentcommittees.csv")

# every person referenced must exist in people.csv; fail loudly rather than
# silently dropping a student from the CV
unresolved = setdiff(na.omit(c(d$person_id, d$co_chair_id)), people$person_id)
if (length(unresolved))
  stop("person_id not found in people.csv: ", paste(unresolved, collapse=", "))

d = d %>%
  left_join(people %>% select(person_id, Student = name), by = "person_id") %>%
  left_join(people %>% select(co_chair_id = person_id, `Co-chair` = name),
            by = "co_chair_id") %>%
  # master's degrees are reported together regardless of whether the awarding
  # department calls it an MS or an MA
  mutate(Degree = ifelse(Degree == "MA", "MS", Degree)) %>%
  select(Student, School, Department, Degree, Completed, Chair, `Co-chair`) %>%
  mutate(School = factor(School, levels=c("ISU","UCSB")),
         Chair  = factor(Chair,  levels=c("Chair","Co-chair","")))

d_levels = unique(d$Department)
d$Department = factor(d$Department,
                      levels = c("STAT",
                                 d_levels[-which(d_levels=="STAT")]))

d = d %>%
  arrange(School, desc(Completed), Degree, Chair, Department)
@


<<advisees, dependson="read_studentcommittees", results='asis'>>=
tab = xtable(d %>%
               filter(Chair %in% c('Chair','Co-chair')) %>%
               arrange(School, Degree, desc(Completed), Chair),
             caption = "Graduate students advised",
             label   = "tab:advisees")

print(tab,
      include.rownames  = FALSE,
      table.placement   = "h",
      caption.placement = "top")
@


<<committees, dependson="read_studentcommittees", results='asis'>>=
s = d %>%
  # filter(!(Chair %in% c("Chair","Co-chair"))) %>%
  mutate(`Chair/Co-chair` = ifelse(Chair %in% c("Chair","Co-chair"), 'Yes', "No"),
         STAT = ifelse(Department %in% c('STAT','PSTAT','STAT&ECON'), 'Yes', 'No'),
         prog = ifelse(Completed == 'In progress', 'In progress', 'Completed')) %>%
  group_by(Degree, `Chair/Co-chair`, STAT, prog) %>%
  dplyr::summarize(n = length(Student)) %>%
  tidyr::spread(prog,n,fill=0) %>%
  select(`Chair/Co-chair`, STAT, Degree, Completed, `In progress`) %>%
  arrange(desc(`Chair/Co-chair`), STAT, Degree)

tab2 = xtable(s,
              caption='Graduate student committees',
              label="tab:committees",
              digits=0)

print(tab2,
      include.rownames=FALSE,
      table.placement="h",
      caption.placement="top")
@

<<undergraduate-research, results='asis', cache.extra = tools::md5sum("data/undergraduate_research.csv")>>=

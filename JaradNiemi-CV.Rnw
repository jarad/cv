\section{Publications}

* Indicates a student advisee or co-advisee.

\vspace{-0.3in}

<<read_pubs, echo=FALSE, cache=TRUE, cache.extra = c(tools::md5sum('data/publications.csv'), tools::md5sum('data/people.csv'), tools::md5sum('data/aliases.csv'), tools::md5sum('data/studentcommittees.csv')), message=FALSE>>=
people     = readr::read_csv("data/people.csv")
aliases    = readr::read_csv("data/aliases.csv")
committees = readr::read_csv("data/studentcommittees.csv")

# every way a person's name may appear in a byline
spellings = dplyr::bind_rows(
  people  %>% dplyr::transmute(person_id, spelling = name),
  aliases %>% dplyr::transmute(person_id, spelling = alias))
spellings = spellings[order(-nchar(spellings$spelling)),]   # longest first

# chair or co-chair both count as having advised the student
advisee_ids = unique(committees$person_id[!is.na(committees$Chair)])

# escape regex metacharacters one at a time; a character class trips over {}
rx_escape = function(s) {
  for (ch in c("\\", ".", "|", "(", ")", "[", "]", "{", "}", "^", "$", "*", "+", "?"))
    s = gsub(ch, paste0("\\", ch), s, fixed=TRUE)
  s
}

decorate_authors = function(s) {
  if (is.na(s)) return(s)
  out = tex_escape(s)
  for (i in seq_len(nrow(spellings))) {
    pid = spellings$person_id[i]
    esc = tex_escape(spellings$spelling[i])
    if (!grepl(esc, out, fixed=TRUE)) next
    rep = if (pid == "jarad-niemi")      paste0("{\\bf ", esc, "}")
          else if (pid %in% advisee_ids) paste0(esc, "*")
          else next
    # a spelling only counts at an author boundary, so "J. Niemi" does not
    # match inside "Gerald J. Niemi"
    pat = paste0("(^|,\\s*|\\s+and\\s+|\\(\\s*)", rx_escape(esc), "(?=$|[,.;)]|\\s)")
    out = gsub(pat, paste0("\\1", gsub("\\\\", "\\\\\\\\", rep)), out, perl=TRUE)
  }
  out
}

# Work appearing on or after this date counts as since my promotion to
# Professor. The boundary is the promotion dossier, not the effective date of
# the title, which is why it falls in early 2022 rather than 2023.
PROMOTION_DATE = as.Date("2022-01-01")

pubs = readr::read_csv("data/publications.csv") %>%
  arrange(-year) %>%
  mutate(authors_tex = vapply(authors, decorate_authors, character(1)),
         title_tex   = tex_text(title),
         journal_tex = tex_text(journal),
         first_public = pmin(iso_floor(date_online), iso_floor(date_print), na.rm=TRUE),
         first_public = dplyr::coalesce(first_public,
                          as.Date(ifelse(is.na(year), NA_character_,
                                         sprintf("%04d-01-01", year)))),
         since_promotion = first_public >= PROMOTION_DATE)
@

\if1\includeinprep
<<in_preparation, dependson="read_pubs", results='asis'>>=
in_prep_print = function(d) {
  if (nrow(d)==0) return(data.frame(a=1)) # to avoid error

  cat("\\begin{samepage}\n",
    d$authors_tex, ". ",
      d$title_tex,
      "\n\\end{samepage}\n\n",
      sep="")
  return(data.frame(a=1)) # to avoid error
}

in_prep = pubs %>% filter(status=="in preparation", type=="journal article")

# Only emit the heading when there is something to put under it. In
# preparation work is usually only listed close to a promotion case, so most
# of the time this section should not appear at all.
if (nrow(in_prep) > 0) {
  cat("\\subsection{\\bf In preparation} \\vspace{-0.2in}\n")
  in_prep = in_prep %>% arrange(desc(sort_order))
  for (i in seq_len(nrow(in_prep))) in_prep_print(in_prep[i,])
}
@
\fi



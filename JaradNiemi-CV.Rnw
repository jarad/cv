\section{\bf Education}

<<education, dependson="helpers", cache=TRUE, cache.extra = tools::md5sum("data/education.csv"), results='asis', message=FALSE>>=
ed = readr::read_csv("data/education.csv") %>% arrange(desc(year))
for (i in seq_len(nrow(ed))) {
  d = ed[i,]
  cat(tex_text(d$degree), " ", tex_text(d$field), ", ", tex_text(d$institution),
      ", ", d$year, "\n", sep="")
  if (!is.na(d$thesis))  cat("\\\\\nThesis: ", tex_text(d$thesis), "\n", sep="")
  if (!is.na(d$advisor)) cat("\\\\\nAdvisor: ", tex_text(d$advisor), "\n", sep="")
  cat("\n")
}
@

\section{\bf Academic Positions}

<<positions, dependson="helpers", cache=TRUE, cache.extra = tools::md5sum("data/positions.csv"), results='asis', message=FALSE>>=
pos = readr::read_csv("data/positions.csv")
# appointments are grouped by the unit they were held in, newest first
pos = pos[order(-as.integer(pos$start_date)),]
grp = paste(pos$unit, pos$institution, sep = "\r")

cat("\\begin{tabular}{l@{\\qquad}r}\n")
first = TRUE
for (g in unique(grp)) {
  d = pos[grp == g,]
  if (!first) cat("\\\\\n")
  first = FALSE
  cat(tex_text(d$unit[1]), " & ", tex_text(d$institution[1]), " \\\\\n", sep="")
  for (i in seq_len(nrow(d)))
    cat("\\quad ", tex_text(d$title[i]), " & ",
        span(d$start_date[i], d$end_date[i], academic = FALSE), " \\\\\n", sep="")
}
cat("\\end{tabular}\n")
@

\section{\bf Employment}

<<employment, dependson="helpers", cache=TRUE, cache.extra = tools::md5sum("data/employment.csv"), results='asis', message=FALSE>>=
emp = readr::read_csv("data/employment.csv")

cat("\\begin{tabular}{l@{\\qquad}l@{\\qquad}r}\n")
for (r in unique(emp$role)) {
  d = emp[emp$role == r,]
  d = d[order(-as.integer(d$start_date)),]
  for (i in seq_len(nrow(d))) {
    # the role is named once, then left blank down the column
    who = tex_text(d$employer[i])
    if (!is.na(d$supervisor[i])) who = paste0(who, " (", tex_text(d$supervisor[i]), ")")
    cat(if (i == 1) tex_text(r) else "", " & ", who, " & ",
        span(d$start_date[i], d$end_date[i], academic = FALSE), " \\\\\n", sep="")
  }
}
cat("\\end{tabular}\n")
@


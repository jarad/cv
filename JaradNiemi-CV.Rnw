\section{\bf Courses taught}
\vspace{0.1in}

<<courses, dependson="read_presentations", cache=TRUE, cache.extra = tools::md5sum("data/courses.csv"), results='asis', message=FALSE>>=
courses = readr::read_csv("data/courses.csv")

TERM_ORDER = c(Spring=1, Summer=2, Fall=3, Winter=4,
               Jan=1, Feb=2, Mar=3, Apr=4, May=5, Jun=6,
               Jul=7, Aug=8, Sep=9, Oct=10, Nov=11, Dec=12)
ord = function(d) order(-as.integer(d$year), -TERM_ORDER[d$term])

reg = courses[courses$kind == "regular",]
cat("{\\bf Regular courses}\n\n\\begin{tabular}{lll}\n")
for (inst in unique(reg$institution)) {
  dd = reg[reg$institution == inst,]
  dd = dd[ord(dd),]
  cat("\\multicolumn{3}{l}{At ", tex_text(inst), ":} \\\\\n\\hline\n", sep="")
  prev = ""
  for (j in seq_len(nrow(dd))) {
    tm = paste(dd$term[j], dd$year[j])
    # the term is printed once and left blank for further courses that term
    shown = if (identical(tm, prev)) "" else tm
    prev = tm
    cat(shown, " & ", tex_text(dd$number[j]), " & ", tex_text(dd$title[j]), " \\\\\n", sep="")
  }
  cat("\\hline\n\\\\\n")
}
cat("\\end{tabular}\n\n")

sh = courses[courses$kind == "short",]
sh = sh[ord(sh),]
cat("\\filbreak\n{\\bf Short courses}\n\n\\begin{tabular}{l p{2.2in} p{2.0in} l}\n")
for (j in seq_len(nrow(sh))) {
  cat(sh$term[j], " ", sh$year[j], " & ", tex_text(sh$title[j]), " & ",
      tex_text(sh$institution[j]), " & ", tex_text(sh$duration[j]), " \\\\\n", sep="")
}
cat("\\end{tabular}\n")
@

\filbreak
\section{\bf Grants}

<<grants, dependson="read_presentations", cache=TRUE, cache.extra = tools::md5sum("data/grants.csv"), results='asis', message=FALSE>>=
grants = readr::read_csv("data/grants.csv") %>% arrange(desc(start_date))

# $1,088,156 and $746,204.44 -- thousands separators, cents only when present
money = function(a) {
  if (is.na(a)) return(NA_character_)
  paste0("\\$", formatC(a, format = "f",
                         digits = if (a == round(a)) 0 else 2, big.mark = ","))
}

cat("\\begin{itemize}\n")
was_since = TRUE
for (i in seq_len(nrow(grants))) {
  d = grants[i,]
  # placed by date, so adding a grant cannot strand it on the wrong side
  since = !is.na(d$start_date) && iso_floor(d$start_date) >= PROMOTION_DATE
  if (was_since && !since) cat("\\sinceappt\n")
  was_since = since

  amounts = if (is.na(d$amount_total)) "" else
    paste0(" [", money(d$amount_total),
           if (!is.na(d$amount_niemi)) paste0("; ", money(d$amount_niemi), " to Niemi") else "",
           "]")

  cat("\\item ", tex_text(d$funder),
      if (!is.na(d$award_number)) paste0(" (\\#", tex_text(d$award_number), ")") else "",
      ", ", tex_text(d$title), ",",
      if (!is.na(d$role)) paste0(" Role: ", tex_text(d$role), ",") else "",
      " ", fmt_date(d$start_date), " to ", fmt_date(d$end_date),
      amounts,
      if (!is.na(d$notes)) paste0(" (", tex_text(d$notes), ")") else "",
      "\n", sep="")
}
cat("\\end{itemize}\n")
@

\filbreak
\section{\bf Honors and Awards}

<<honors, dependson="read_pubs", cache=TRUE, cache.extra = c(tools::md5sum("data/honors.csv"), tools::md5sum("data/memberships.csv")), results='asis', message=FALSE>>=
honors = readr::read_csv("data/honors.csv") %>% arrange(desc(start_date))

link = function(text, href) if (is.na(href)) text else paste0("\\href{", href, "}{", text, "}")

cat("\\begin{itemize}\n")
was_since = TRUE
for (i in seq_len(nrow(honors))) {
  d = honors[i,]
  since = !is.na(d$start_date) && iso_floor(d$start_date) >= PROMOTION_DATE
  if (was_since && !since) cat("\\sinceappt\n")
  was_since = since

  label = tex_text(d$name)
  if (!is.na(d$organization)) label = paste0(tex_text(d$organization), " ", label)
  cat("\\item ", link(label, d$url),
      if (!is.na(d$notes)) paste0(" (", link(tex_text(d$notes), d$notes_url), ")") else "",
      if (!is.na(d$amount)) paste0(" [\\$", formatC(d$amount, format="d", big.mark=","), "]") else "",
      " (", span(d$start_date, d$end_date), ")\n", sep="")
}
cat("\\end{itemize}\n")
@

